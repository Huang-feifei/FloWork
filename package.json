{
  "name": "flowork",
  "version": "0.1.0",
  "private": true,
  "description": "FloWork — 以 pi coding agent 为内核、以对话为中心的桌面应用",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:web": "node scripts/dev-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "start:web": "node scripts/start-web.mjs --open",
    "smoke:web": "node scripts/build-web.mjs && node scripts/start-web.mjs --smoke",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "ignore": "7.0.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "zustand": "5.0.15"
  }
}
