{
  "name": "flowork",
  "version": "1.0.3",
  "private": true,
  "description": "FloWork — 以 pi coding agent 为内核、以对话为中心的桌面应用",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:web": "node scripts/dev-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "start:web": "node scripts/start-web.mjs --open",
    "smoke:web": "node scripts/build-web.mjs && node scripts/start-web.mjs --smoke",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:win": "electron-vite build && electron-builder --win --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "preview": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "ignore": "7.0.8",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "style-mod": "4.1.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "zustand": "5.0.15"
  }
}
